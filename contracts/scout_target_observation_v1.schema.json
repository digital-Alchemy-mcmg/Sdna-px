{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SCOUT_TARGET_OBSERVATION_v1",
  "type": "object",
  "required": [
    "contract_version",
    "observation_id",
    "provenance",
    "entity_metadata",
    "demand_envelope"
  ],
  "properties": {
    "contract_version": {
      "const": "SCOUT_TARGET_OBSERVATION_v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_url",
        "disk_cartridge_hash"
      ],
      "properties": {
        "source_url": {
          "type": "string"
        },
        "disk_cartridge_hash": {
          "type": "string"
        }
      }
    },
    "entity_metadata": {
      "type": "object",
      "required": [
        "employer",
        "job_title",
        "location",
        "compensation"
      ]
    },
    "demand_envelope": {
      "type": "object",
      "required": [
        "receptors"
      ],
      "properties": {
        "receptors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "receptor_id",
              "category",
              "verbatim_text"
            ],
            "properties": {
              "receptor_id": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "verbatim_text": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              }
            }
          }
        },
        "negative_space_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
